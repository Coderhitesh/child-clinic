# Points the app at the clinic API. On a phone, localhost is the phone itself —
# use your machine's LAN IP (or a tunnel URL) so the device can reach the backend.
EXPO_PUBLIC_API_URL=http://192.168.1.5:5000/api/v1

# Razorpay public key id (the secret stays on the server)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
